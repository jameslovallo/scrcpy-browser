<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScrcpyLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ScrcpyLauncher.Models"
    xmlns:services="using:ScrcpyLauncher.Services"
    Title="Scrcpy Launcher">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Title bar: no title; device picker on the left, focused app name over the view  -->
        <TitleBar x:Name="AppTitleBar">
            <TitleBar.LeftHeader>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Grid x:Name="SidebarHeader">
                        <Button
                            x:Name="DeviceButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Device"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="No device">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid VerticalAlignment="Center">
                                    <FontIcon FontSize="16" Glyph="&#xE8EA;" />
                                    <Ellipse
                                        x:Name="DeviceStatusDot"
                                        Width="6"
                                        Height="6"
                                        Margin="0,0,-3,-1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Fill="{ThemeResource SystemFillColorCautionBrush}" />
                                </Grid>
                                <TextBlock
                                    x:Name="DeviceNameText"
                                    VerticalAlignment="Center"
                                    Text="No device"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout
                                    x:Name="DeviceMenu"
                                    Opening="DeviceMenu_Opening"
                                    Placement="BottomEdgeAlignedLeft"
                                    ShouldConstrainToRootBounds="False" />
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <!--  Focused app name, left-aligned with the main view (offset set in code)  -->
                    <TextBlock
                        x:Name="AppTitleText"
                        MaxWidth="480"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="304" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar (on Mica)  -->
            <Grid
                x:Name="Sidebar"
                Padding="8,0,8,8"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Search: type to filter, Enter or click to launch  -->
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    AutomationProperties.Name="Search apps"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    GotFocus="SearchBox_GotFocus"
                    LostFocus="SearchBox_LostFocus"
                    MaxSuggestionListHeight="520"
                    PlaceholderText="Open an app"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged"
                    UpdateTextOnSelect="False">
                    <!--  Uniform stroke instead of the bottom accent line; focus is shown by elevation (shadow + focused fill)  -->
                    <AutoSuggestBox.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ControlStrokeColorDefaultBrush" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                                    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="SystemColorHighlightColorBrush" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <!--  Taller field: extra vertical padding around the text (default is 10,5,6,6)  -->
                            <Thickness x:Key="TextControlThemePadding">10,8,6,8</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                        </ResourceDictionary>
                    </AutoSuggestBox.Resources>
                    <AutoSuggestBox.Shadow>
                        <ThemeShadow />
                    </AutoSuggestBox.Shadow>
                    <AutoSuggestBox.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.167" />
                    </AutoSuggestBox.TranslationTransition>
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AndroidApp">
                            <Grid Padding="0,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20">
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="{x:Bind Initial}" />
                                    </Border>
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>

                <!--  Pinned apps: icon grid  -->
                <GridView
                    x:Name="PinnedGrid"
                    Grid.Row="1"
                    Margin="-4"
                    AllowDrop="True"
                    AutomationProperties.Name="Pinned apps"
                    CanDragItems="True"
                    CanReorderItems="True"
                    ContainerContentChanging="PinnedGrid_ContainerContentChanging"
                    DragItemsCompleted="PinnedGrid_DragItemsCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="PinnedGrid_ItemClick"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectionMode="None"
                    UseLayoutRounding="False">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:PinnedTile">
                            <Border
                                Width="66"
                                Height="48"
                                AutomationProperties.Name="{x:Bind App.Name}"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource OverlayCornerRadius}"
                                ToolTipService.ToolTip="{x:Bind App.Name}">
                                <Grid>
                                    <!--  Running tint: a plain rectangle clipped to the parent's rounded corners for a single clean (anti-aliased) edge  -->
                                    <Rectangle
                                        Fill="{ThemeResource RunningTileBackgroundBrush}"
                                        Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                    <Grid
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Border
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="6"
                                            Visibility="{x:Bind App.InitialVisibility, Mode=OneWay}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind App.Initial}" />
                                        </Border>
                                        <Image Source="{x:Bind App.Icon, Mode=OneWay}" />
                                    </Grid>
                                    <Border
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource OverlayCornerRadius}"
                                        Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Rectangle
                    x:Name="RunningDivider"
                    Grid.Row="2"
                    Height="1"
                    Margin="4,0"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <!--  Running (unpinned) apps  -->
                <ListView
                    x:Name="RunningList"
                    Grid.Row="3"
                    Margin="-4,0"
                    AutomationProperties.Name="Running apps"
                    ContainerContentChanging="RunningList_ContainerContentChanging"
                    SelectionChanged="RunningList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:ScrcpySession">
                            <Grid Padding="0,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20">
                                    <Border
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind App.InitialVisibility, Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind Initial}" />
                                    </Border>
                                    <Image Source="{x:Bind App.Icon, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <Button
                                    Grid.Column="2"
                                    Padding="6"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Close"
                                    Click="CloseSession_Click"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Close">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <InfoBar
                    x:Name="StatusBar"
                    Grid.Row="4"
                    IsClosable="True"
                    IsOpen="False" />

                <!--  Footer: settings and audio (left), and Android Back (right)  -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="SettingsButton"
                            AutomationProperties.Name="Settings"
                            Click="SettingsButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Settings">
                            <FontIcon FontSize="16" Glyph="&#xE713;" />
                        </Button>
                        <Button
                            x:Name="AudioCaptureButton"
                            AutomationProperties.Name="Device audio capture"
                            Click="AudioCaptureButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Enable device audio capture">
                            <FontIcon
                                x:Name="AudioCaptureIcon"
                                FontSize="16"
                                Glyph="&#xE74F;" />
                        </Button>
                    </StackPanel>
                    <Button
                        x:Name="BackButton"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Back"
                        Click="BackButton_Click"
                        IsEnabled="False"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Back">
                        <!--  Play glyph rotated 180° = left-pointing (back) triangle  -->
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE768;"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="180" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </Grid>
            </Grid>

            <!--  Main view: inset content card; the selected scrcpy window is embedded over HostArea  -->
            <Border
                x:Name="HostCard"
                Grid.Column="1"
                Margin="0,0,8,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid x:Name="HostArea">
                    <StackPanel
                        x:Name="Placeholder"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <Grid Height="56">
                            <FontIcon
                                x:Name="PlaceholderIcon"
                                FontSize="48"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8EA;" />
                            <ProgressRing
                                x:Name="LaunchProgress"
                                Width="48"
                                Height="48"
                                IsActive="False" />
                        </Grid>
                        <TextBlock
                            x:Name="PlaceholderTitle"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="No app selected" />
                        <TextBlock
                            x:Name="PlaceholderText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Pick a pinned app, or search and press Enter, to start mirroring."
                            TextAlignment="Center" />
                    </StackPanel>

                    <!--  Settings view: shown in place of the mirror (the scrcpy window is hidden meanwhile)  -->
                    <ScrollViewer x:Name="SettingsView" Visibility="Collapsed">
                        <StackPanel
                            MaxWidth="1000"
                            HorizontalAlignment="Center"
                            Padding="36,24,36,36"
                            Spacing="4">
                            <TextBlock
                                Margin="0,0,0,8"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Hidden apps" />
                            <TextBlock
                                x:Name="NoHiddenAppsText"
                                Margin="0,0,0,4"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No hidden apps. Right-click an app in the sidebar and choose Hide to remove it from search and the pinned grid." />
                            <ItemsRepeater x:Name="HiddenAppsList">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AndroidApp">
                                        <Grid
                                            MinHeight="56"
                                            Padding="16,8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            ColumnSpacing="16"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="24"
                                                Height="24"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="6"
                                                    Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{x:Bind Initial}" />
                                                </Border>
                                                <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="2"
                                                MinWidth="96"
                                                AutomationProperties.HelpText="{x:Bind Name}"
                                                Click="RestoreApp_Click"
                                                Content="Restore"
                                                Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Grid Margin="0,28,0,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Installed apps" />
                                <AutoSuggestBox
                                    x:Name="ManageSearchBox"
                                    Grid.Column="1"
                                    Width="260"
                                    AutomationProperties.Name="Filter installed apps"
                                    PlaceholderText="Filter"
                                    QueryIcon="Filter"
                                    TextChanged="ManageSearchBox_TextChanged" />
                            </Grid>
                            <ItemsRepeater x:Name="InstalledAppsList">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:AndroidApp">
                                        <Grid
                                            MinHeight="56"
                                            Padding="16,8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            ColumnSpacing="16"
                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="24"
                                                Height="24"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="6"
                                                    Visibility="{x:Bind InitialVisibility, Mode=OneWay}">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{x:Bind Initial}" />
                                                </Border>
                                                <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    MinWidth="96"
                                                    AutomationProperties.HelpText="{x:Bind Name}"
                                                    Click="ToggleHiddenApp_Click"
                                                    Content="{x:Bind HiddenActionText, Mode=OneWay}"
                                                    Tag="{x:Bind}" />
                                                <Button
                                                    MinWidth="96"
                                                    AutomationProperties.HelpText="{x:Bind Name}"
                                                    Click="UninstallApp_Click"
                                                    Content="Uninstall"
                                                    Tag="{x:Bind}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
